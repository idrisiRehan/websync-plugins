{
  "name": "llms-txt-kit",
  "version": "1.0.0",
  "description": "Lint and generate llms.txt files against the llmstxt.org proposal, with line numbers. Parses to a document you can render back to canonical markdown. Zero dependencies, plus a CLI for files, stdin and URLs.",
  "type": "module",
  "exports": {
    ".": {
      "websync-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "llms-txt-kit": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "prepublishOnly": "npm test && npm run build"
  },
  "keywords": [
    "llms.txt",
    "llms-txt",
    "llmstxt",
    "llm",
    "ai",
    "agents",
    "markdown",
    "validator",
    "lint",
    "linter",
    "generator",
    "seo",
    "cli"
  ],
  "author": "Rehan Idrisi (https://websync.in/about/)",
  "license": "MIT",
  "homepage": "https://github.com/idrisiRehan/websync-plugins/tree/main/packages/llms-txt-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idrisiRehan/websync-plugins.git",
    "directory": "packages/llms-txt-kit"
  },
  "bugs": {
    "url": "https://github.com/idrisiRehan/websync-plugins/issues"
  }
}
