{
  "name": "robots-txt-lint",
  "version": "1.0.0",
  "description": "Lint robots.txt files against RFC 9309 and how Google reads them, test URLs against the rules, and see which AI crawlers are allowed. Zero dependencies, plus a CLI for files, stdin and URLs.",
  "type": "module",
  "exports": {
    ".": {
      "websync-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "robots-txt-lint": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "prepublishOnly": "npm test && npm run build"
  },
  "keywords": [
    "robots.txt",
    "robots",
    "rfc9309",
    "crawler",
    "ai-crawlers",
    "gptbot",
    "seo",
    "validator",
    "lint",
    "linter",
    "cli"
  ],
  "author": "Rehan Idrisi (https://websync.in/about/)",
  "license": "MIT",
  "homepage": "https://github.com/idrisiRehan/websync-plugins/tree/main/packages/robots-txt-lint#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idrisiRehan/websync-plugins.git",
    "directory": "packages/robots-txt-lint"
  },
  "bugs": {
    "url": "https://github.com/idrisiRehan/websync-plugins/issues"
  }
}
